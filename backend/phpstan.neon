# The shared PHPStan bar: level 8. Larastan,
# phpstan-strict-rules and phpstan-deprecation-rules load through
# phpstan/extension-installer, so they need no `includes:` here.
includes:
    - ../shared/lint/php/phpstan.neon

parameters:
    paths:
        - app
        - bootstrap/app.php
        - config
        - database
        - routes
        - tests
    treatPhpDocTypesAsCertain: false
    ignoreErrors:
        # Larastan describes every query-builder method an Eloquent builder
        # forwards to (orderBy, whereIn, …) as static: its
        # EloquentBuilderMethodReflection::isStatic() always returns true. So
        # strict-rules reports each of those instance calls as a dynamic call to
        # a static method. None of them is static.
        -
            identifier: staticMethod.dynamicCall
            message: '#^Dynamic call to static method Illuminate\\Database\\Eloquent\\Builder<.+>::\w+\(\)\.$#'
