{
    "$schema": "https://getcomposer.org/schema.json",
    "name": "mathdad/gallery",
    "type": "project",
    "description": "A self-hosted personal media gallery for images, GIFs, and videos with Danbooru-style tagging (Laravel backend).",
    "license": "MIT",
    "require": {
        "php": "^8.5",
        "ext-curl": "*",
        "ext-fileinfo": "*",
        "ext-gd": "*",
        "ext-mbstring": "*",
        "ext-pdo": "*",
        "ext-pdo_sqlite": "*",
        "intervention/image": "^4.4",
        "intervention/imagehash": "^1.0",
        "laravel/framework": "^13.0",
        "laravel/passkeys": "0.2.1",
        "laravel/tinker": "^3.0"
    },
    "require-dev": {
        "driftingly/rector-laravel": "^2.7",
        "fakerphp/faker": "^1.23",
        "larastan/larastan": "^3.13",
        "laravel/pail": "^1.2.5",
        "laravel/pint": "^1.27",
        "mockery/mockery": "^1.6",
        "nunomaduro/collision": "^8.6",
        "pestphp/pest": "^5.0",
        "pestphp/pest-plugin-laravel": "^5.0",
        "phpstan/extension-installer": "^1.4",
        "phpstan/phpstan-deprecation-rules": "^2.0",
        "phpstan/phpstan-strict-rules": "^2.1",
        "rector/rector": "^2.8",
        "zircote/swagger-php": "^7.0"
    },
    "autoload": {
        "psr-4": {
            "App\\": "app/",
            "Database\\Factories\\": "database/factories/",
            "Database\\Seeders\\": "database/seeders/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Tests\\": "tests/"
        }
    },
    "scripts": {
        "setup": [
            "composer install",
            "@php -r \"file_exists('.env') || copy('.env.example', '.env');\"",
            "@php artisan key:generate"
        ],
        "dev": [
            "Composer\\Config::disableProcessTimeout",
            "@php artisan serve"
        ],
        "analyse": "phpstan analyse --memory-limit=1G",
        "docs": "@php bin/openapi.php",
        "lint": "pint --test",
        "lint:fix": "pint",
        "rector": "rector process",
        "rector:check": "rector process --dry-run",
        "test": [
            "@php artisan config:clear --ansi",
            "pest"
        ],
        "post-autoload-dump": [
            "Illuminate\\Foundation\\ComposerScripts::postAutoloadDump",
            "@php artisan package:discover --ansi"
        ],
        "post-update-cmd": [
            "@php artisan vendor:publish --tag=laravel-assets --ansi --force"
        ],
        "pre-package-uninstall": [
            "Illuminate\\Foundation\\ComposerScripts::prePackageUninstall"
        ]
    },
    "extra": {
        "laravel": {
            "dont-discover": []
        }
    },
    "config": {
        "optimize-autoloader": true,
        "preferred-install": "dist",
        "sort-packages": true,
        "allow-plugins": {
            "pestphp/pest-plugin": true,
            "php-http/discovery": true,
            "phpstan/extension-installer": true
        },
        "platform": {
            "php": "8.5.12"
        },
        "policy": {
            "abandoned": {
                "ignore": {
                    "symplify/rule-doc-generator-contracts": "Dev-only: required by driftingly/rector-laravel, abandoned upstream with no replacement."
                }
            }
        }
    },
    "minimum-stability": "dev",
    "prefer-stable": true
}
