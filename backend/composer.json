{
    "name": "mathdad/gallery",
    "description": "A self-hosted personal media gallery for images, GIFs, and videos with Danbooru-style tagging.",
    "license": "MIT",
    "type": "project",
    "version": "3.3.0",
    "require": {
        "php": ">=8.5",
        "ext-curl": "*",
        "ext-fileinfo": "*",
        "ext-gd": "*",
        "ext-mbstring": "*",
        "ext-pdo": "*",
        "ext-pdo_sqlite": "*",
        "intervention/image": "^4.4",
        "intervention/imagehash": "^1.0",
        "monolog/monolog": "^3.0",
        "php-di/php-di": "^7.1",
        "psr/http-message": "^2.0",
        "psr/http-server-handler": "^1.0",
        "slim/http": "^1.0",
        "slim/psr7": "^1.0",
        "slim/slim": "^4.0"
    },
    "require-dev": {
        "ergebnis/composer-normalize": "^2.56",
        "friendsofphp/php-cs-fixer": "^3.95",
        "icanhazstring/composer-unused": "^0.9.8",
        "maglnet/composer-require-checker": "^4.24",
        "phpdocumentor/shim": "^3.0",
        "phpstan/extension-installer": "^1.4",
        "phpstan/phpstan": "^2.3",
        "phpstan/phpstan-deprecation-rules": "^2.0",
        "phpstan/phpstan-phpunit": "^2.0",
        "phpstan/phpstan-strict-rules": "^2.1",
        "phpunit/phpunit": "^13.0",
        "rector/rector": "^2.8",
        "roave/security-advisories": "dev-latest",
        "robmorgan/phinx": "^0.16",
        "zircote/swagger-php": "^7.0"
    },
    "autoload": {
        "psr-4": {
            "Gallery\\": [
                "includes/Gallery"
            ],
            "Routes\\": [
                "api/Routes"
            ]
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Gallery\\Tests\\": "tests/"
        }
    },
    "config": {
        "allow-plugins": {
            "ergebnis/composer-normalize": true,
            "phpdocumentor/shim": true,
            "phpstan/extension-installer": true
        },
        "optimize-autoloader": true,
        "platform": {
            "php": "8.5.12"
        },
        "preferred-install": "dist",
        "sort-packages": true
    },
    "scripts": {
        "analyse": "phpstan analyse --memory-limit=1G",
        "deps:check": [
            "composer-unused --no-progress",
            "composer-require-checker check composer.json --config-file=composer-require-checker.json"
        ],
        "docs": "@php bin/openapi.php",
        "lint": "php-cs-fixer check --show-progress=none",
        "lint:fix": "php-cs-fixer fix",
        "rector": "rector process",
        "rector:check": "rector process --dry-run",
        "test": "phpunit",
        "test:coverage": "phpunit --coverage-text"
    }
}
