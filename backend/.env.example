APP_NAME=Gallery
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

# The gallery's SQLite database. Use an absolute path. Unset, it is
# database/database.sqlite. On the droplet, beside the app in its folder:
# DB_DATABASE=/var/www/gallery.mathdad.me/db/gallery.db
DB_CONNECTION=sqlite
# DB_DATABASE=

# Sessions are rows in the SQLite file, found by the hash of the session id; the
# cache is files in storage/, and the queue uses the database too. A signed-in
# browser keeps its session in a cookie that lasts until the browser closes
# (SESSION_EXPIRE_ON_CLOSE), and a day without a request (SESSION_LIFETIME, in
# minutes) signs it out; "keep me signed in" adds a 30-day remember cookie. The
# cookie is Secure whenever APP_URL is https, and then named __Host-gallery-session
# (the browser accepts a __Host- cookie only from a secure page, for this host alone).
SESSION_DRIVER=database
SESSION_LIFETIME=1440
SESSION_EXPIRE_ON_CLOSE=true
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database
CACHE_STORE=file

# The droplet's timezone (`timedatectl`), so the nightly ingest runs at its
# midnight.
SCHEDULE_TIMEZONE=UTC


# ── Gallery (config/gallery.php) ─────────────────────────────────────────────

# Whether anyone may create an account (true unless set to false). Accounts
# keep their own favorite lists, blocked tags and saved searches; admins are
# made with `php artisan gallery:user <name> --admin`, never by signing up.
GALLERY_ALLOW_SIGNUP=true

# Cloudflare Turnstile, the bot check on sign-up and login (dash.cloudflare.com,
# Turnstile; add the site's hostname to the widget). Leave the secret empty to
# switch the check off, as for local development. Cloudflare's test keys
# (1x00000000000000000000AA / 1x0000000000000000000000000000000AA) always pass.
CLOUDFLARE_TURNSTILE_SITEKEY=
CLOUDFLARE_TURNSTILE_SECRET=

# Public base URL (used to build absolute URLs for Danbooru tag fetching / IQDB fallback).
GALLERY_URL=https://gallery.example.com

# Comma-separated list of allowed origins (backs both CORS and the CSRF origin check).
GALLERY_ALLOWED_ORIGINS=https://gallery.example.com

# Optional: Danbooru API credentials for automatic tag importing.
DANBOORU_LOGIN=
DANBOORU_API_KEY=
# The account's numeric user ID (on its Danbooru profile page). It goes in the
# User-Agent ("GalleryTagImporter/1.0; user #123"), as Danbooru asks of API
# clients; without it, Danbooru's firewall may block the server's requests.
DANBOORU_USER_ID=

# Optional: duplicate-scan tuning (used by the Duplicates page's scan and by gallery:dupes).
# Largest Hamming distance (bits out of 64) still reported, 0-16. Default 6.
DUPLICATE_MAX_DISTANCE=
# Largest difference, 0-255, allowed in the region where a pair differs most: re-saved copies
# score low, variants with one detail changed score high. Default 36; "off" disables the check.
DUPLICATE_MAX_REGION_DIFF=

# Where media (full/, thumbs/, the ingest folder) and duplicate-scan reports live. Use
# absolute paths. Unset, they are storage/app/media and storage/app/dupes. On the droplet:
# GALLERY_MEDIA_PATH=/var/www/gallery.mathdad.me/media
# GALLERY_DUPES_PATH=/var/www/gallery.mathdad.me/dupes
GALLERY_MEDIA_PATH=
GALLERY_DUPES_PATH=
