{
    "id": "tags/delete-not-found",
    "route": "DELETE /tags/{tag_id}",
    "about": "An unknown tag: 404 TagDoesNotExist. Id 0: 400 InvalidTagID.",
    "steps": [
        {
            "request": {
                "method": "DELETE",
                "path": "/api/tags/999",
                "headers": {
                    "Accept": "*/*",
                    "Origin": "https://gallery.test",
                    "Authorization": "Bearer <admin-token>"
                }
            },
            "response": {
                "status": 404,
                "headers": {
                    "access-control-allow-credentials": "true",
                    "access-control-allow-headers": "X-Requested-With, Content-Type, Accept, Origin, Authorization",
                    "access-control-allow-methods": "GET, POST, PUT, PATCH, DELETE, OPTIONS",
                    "access-control-allow-origin": "https://gallery.test",
                    "access-control-max-age": "86400",
                    "content-type": "application/json",
                    "x-content-type-options": "nosniff",
                    "x-frame-options": "SAMEORIGIN",
                    "x-ratelimit-remaining": "119"
                },
                "json": {
                    "error": "TagDoesNotExist",
                    "message": "The tag to delete could not be found."
                }
            }
        },
        {
            "request": {
                "method": "DELETE",
                "path": "/api/tags/0",
                "headers": {
                    "Accept": "*/*",
                    "Origin": "https://gallery.test",
                    "Authorization": "Bearer <admin-token>"
                }
            },
            "response": {
                "status": 400,
                "headers": {
                    "access-control-allow-credentials": "true",
                    "access-control-allow-headers": "X-Requested-With, Content-Type, Accept, Origin, Authorization",
                    "access-control-allow-methods": "GET, POST, PUT, PATCH, DELETE, OPTIONS",
                    "access-control-allow-origin": "https://gallery.test",
                    "access-control-max-age": "86400",
                    "content-type": "application/json",
                    "x-content-type-options": "nosniff",
                    "x-frame-options": "SAMEORIGIN",
                    "x-ratelimit-remaining": "118"
                },
                "json": {
                    "error": "InvalidTagID",
                    "message": "The tag ID must be a positive number."
                }
            }
        }
    ]
}
