{
    "id": "duplicates/dismiss-invalid",
    "route": "POST /duplicates/dismissals",
    "about": "The same id twice, or no ids: 400 InvalidInput.",
    "steps": [
        {
            "request": {
                "method": "POST",
                "path": "/api/duplicates/dismissals",
                "headers": {
                    "Accept": "*/*",
                    "Origin": "https://gallery.test",
                    "Authorization": "Bearer <admin-token>",
                    "Content-Type": "application/json"
                },
                "json": {
                    "media_id_1": 3,
                    "media_id_2": 3
                }
            },
            "response": {
                "status": 400,
                "headers": {
                    "access-control-allow-credentials": "true",
                    "access-control-allow-headers": "X-Requested-With, Content-Type, Accept, Origin, Authorization",
                    "access-control-allow-methods": "GET, POST, PUT, PATCH, DELETE, OPTIONS",
                    "access-control-allow-origin": "https://gallery.test",
                    "access-control-max-age": "86400",
                    "content-type": "application/json",
                    "x-content-type-options": "nosniff",
                    "x-frame-options": "SAMEORIGIN",
                    "x-ratelimit-remaining": "119"
                },
                "json": {
                    "error": "InvalidInput",
                    "message": "Two different, valid media IDs are required."
                }
            }
        },
        {
