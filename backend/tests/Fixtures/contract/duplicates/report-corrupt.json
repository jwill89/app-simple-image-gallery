{
    "id": "duplicates/report-corrupt",
    "route": "GET /duplicates/report",
    "about": "The newest report is not valid JSON: 500 InvalidReport.",
    "setup": {
        "files": {
            "dupes/dupes-2026-11-01.json": "{\"matches\": ["
        }
    },
    "steps": [
        {
            "request": {
                "method": "GET",
                "path": "/api/duplicates/report",
                "headers": {
                    "Accept": "*/*"
                }
            },
            "response": {
                "status": 500,
                "headers": {
                    "content-type": "application/json",
                    "x-content-type-options": "nosniff",
                    "x-frame-options": "SAMEORIGIN",
                    "x-ratelimit-remaining": "119"
                },
                "json": {
                    "error": "InvalidReport",
                    "message": "The latest report file is corrupted or unreadable."
                }
            }
        }
    ]
}
