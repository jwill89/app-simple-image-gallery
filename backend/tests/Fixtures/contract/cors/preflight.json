{
    "id": "cors/preflight",
    "route": "OPTIONS /{any}",
    "about": "Preflight from an allowed origin: answered by the CORS middleware itself, 200 with an empty body (not 204), before routing, so an unknown path gets the same answer. A foreign origin gets no CORS headers. Preflights are not rate-limited.",
    "steps": [
        {
            "request": {
                "method": "OPTIONS",
                "path": "/api/tags",
                "headers": {
                    "Accept": "*/*",
                    "Origin": "https://gallery.test",
                    "Access-Control-Request-Method": "POST",
                    "Access-Control-Request-Headers": "authorization,content-type"
                }
            },
            "response": {
                "status": 200,
                "headers": {
                    "access-control-allow-credentials": "true",
                    "access-control-allow-headers": "X-Requested-With, Content-Type, Accept, Origin, Authorization",
                    "access-control-allow-methods": "GET, POST, PUT, PATCH, DELETE, OPTIONS",
                    "access-control-allow-origin": "https://gallery.test",
                    "access-control-max-age": "86400",
                    "x-content-type-options": "nosniff",
                    "x-frame-options": "SAMEORIGIN"
                },
                "text": ""
            }
        },
        {
            "request": {
                "method": "OPTIONS",
                "path": "/api/no-such-route",
                "headers": {
                    "Accept": "*/*",
                    "Origin": "https://gallery.test",
                    "Access-Control-Request-Method": "DELETE"
                }
            },
            "response": {
                "status": 200,
                "headers": {
                    "access-control-allow-credentials": "true",
                    "access-control-allow-headers": "X-Requested-With, Content-Type, Accept, Origin, Authorization",
                    "access-control-allow-methods": "GET, POST, PUT, PATCH, DELETE, OPTIONS",
                    "access-control-allow-origin": "https://gallery.test",
                    "access-control-max-age": "86400",
                    "x-content-type-options": "nosniff",
                    "x-frame-options": "SAMEORIGIN"
                },
                "text": ""
            }
        },
        {
            "request": {
                "method": "OPTIONS",
                "path": "/api/tags",
                "headers": {
                    "Accept": "*/*",
                    "Origin": "https://evil.example",
                    "Access-Control-Request-Method": "POST"
                }
            },
            "response": {
                "status": 200,
                "headers": {
                    "x-content-type-options": "nosniff",
                    "x-frame-options": "SAMEORIGIN"
                },
                "text": ""
            }
        }
    ]
}
