{
    "id": "media/upload-no-files",
    "route": "POST /media",
    "about": "A multipart body with no files: 400 NoFilesUploaded.",
    "steps": [
        {
            "request": {
                "method": "POST",
                "path": "/api/media",
                "headers": {
                    "Accept": "*/*",
                    "Origin": "https://gallery.test",
                    "Authorization": "Bearer <admin-token>",
                    "Content-Type": "multipart/form-data"
                },
                "multipart": [
                    {
                        "name": "fetch_tags",
                        "value": "0"
                    }
                ]
            },
            "response": {
                "status": 400,
                "headers": {
                    "access-control-allow-credentials": "true",
                    "access-control-allow-headers": "X-Requested-With, Content-Type, Accept, Origin, Authorization",
                    "access-control-allow-methods": "GET, POST, PUT, PATCH, DELETE, OPTIONS",
                    "access-control-allow-origin": "https://gallery.test",
                    "access-control-max-age": "86400",
                    "content-type": "application/json",
                    "x-content-type-options": "nosniff",
                    "x-frame-options": "SAMEORIGIN",
                    "x-ratelimit-remaining": "119"
                },
                "json": {
                    "error": "NoFilesUploaded",
                    "message": "No files were included in the upload request."
                }
            }
        }
    ]
}
