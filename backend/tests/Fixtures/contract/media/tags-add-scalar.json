{
    "id": "media/tags-add-scalar",
    "route": "PATCH /media/{media_id}/tags",
    "about": "tag_ids as a single number rather than a list is accepted.",
    "steps": [
        {
            "request": {
                "method": "PATCH",
                "path": "/api/media/11/tags",
                "headers": {
                    "Accept": "*/*",
                    "Origin": "https://gallery.test",
                    "Content-Type": "application/json"
                },
                "json": {
                    "tag_ids": 8
                }
            },
            "response": {
                "status": 200,
                "headers": {
                    "access-control-allow-credentials": "true",
                    "access-control-allow-headers": "X-Requested-With, Content-Type, Accept, Origin, Authorization",
                    "access-control-allow-methods": "GET, POST, PUT, PATCH, DELETE, OPTIONS",
                    "access-control-allow-origin": "https://gallery.test",
                    "access-control-max-age": "86400",
                    "content-type": "application/json",
                    "x-content-type-options": "nosniff",
                    "x-frame-options": "SAMEORIGIN",
                    "x-ratelimit-remaining": "119"
                },
                "json": [
                    {
                        "tag_id": 8,
                        "category_id": 1,
                        "tag_name": "smile"
                    }
                ]
            }
        }
    ]
}
