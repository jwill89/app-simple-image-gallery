{
    "id": "auth/login-not-configured",
    "route": "POST /auth/login",
    "about": "GALLERY_ADMIN_PASSWORD unset: 503 AdminNotConfigured, whatever the password.",
    "setup": {
        "env": {
            "GALLERY_ADMIN_PASSWORD": ""
        }
    },
    "steps": [
        {
            "request": {
                "method": "POST",
                "path": "/api/auth/login",
                "headers": {
                    "Accept": "*/*",
                    "Origin": "https://gallery.test",
                    "Content-Type": "application/json"
                },
                "json": {
                    "password": "changeme"
                }
            },
            "response": {
                "status": 503,
                "headers": {
                    "access-control-allow-credentials": "true",
                    "access-control-allow-headers": "X-Requested-With, Content-Type, Accept, Origin, Authorization",
                    "access-control-allow-methods": "GET, POST, PUT, PATCH, DELETE, OPTIONS",
                    "access-control-allow-origin": "https://gallery.test",
                    "access-control-max-age": "86400",
                    "content-type": "application/json",
                    "x-content-type-options": "nosniff",
                    "x-frame-options": "SAMEORIGIN",
                    "x-ratelimit-remaining": "119"
                },
                "json": {
                    "error": "AdminNotConfigured",
                    "message": "Admin access is not configured on the server."
                }
            }
        }
    ]
}
