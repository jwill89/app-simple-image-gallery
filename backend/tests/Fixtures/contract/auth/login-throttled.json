{
    "id": "auth/login-throttled",
    "route": "POST /auth/login",
    "about": "Ten attempts are allowed; the eleventh is 429 TooManyAttempts with Retry-After, even with the right password. The limiter counts every attempt, not only failures.",
    "steps": [
        {
            "repeat": 10,
            "statuses": {
                "401": 10
            },
            "request": {
                "method": "POST",
                "path": "/api/auth/login",
                "headers": {
                    "Accept": "*/*",
                    "Origin": "https://gallery.test",
                    "Content-Type": "application/json"
                },
                "json": {
                    "password": "nope"
                }
            },
            "response": {
                "status": 401,
                "headers": {
                    "access-control-allow-credentials": "true",
                    "access-control-allow-headers": "X-Requested-With, Content-Type, Accept, Origin, Authorization",
                    "access-control-allow-methods": "GET, POST, PUT, PATCH, DELETE, OPTIONS",
                    "access-control-allow-origin": "https://gallery.test",
                    "access-control-max-age": "86400",
                    "content-type": "application/json",
                    "x-content-type-options": "nosniff",
                    "x-frame-options": "SAMEORIGIN",
                    "x-ratelimit-remaining": "110"
                },
                "json": {
                    "error": "InvalidPassword",
                    "message": "The password is incorrect."
                }
            }
        },
        {
            "request": {
                "method": "POST",
                "path": "/api/auth/login",
                "headers": {
                    "Accept": "*/*",
                    "Origin": "https://gallery.test",
                    "Content-Type": "application/json"
                },
                "json": {
                    "password": "nope"
                }
            },
            "response": {
                "status": 429,
                "headers": {
                    "access-control-allow-credentials": "true",
                    "access-control-allow-headers": "X-Requested-With, Content-Type, Accept, Origin, Authorization",
                    "access-control-allow-methods": "GET, POST, PUT, PATCH, DELETE, OPTIONS",
                    "access-control-allow-origin": "https://gallery.test",
                    "access-control-max-age": "86400",
                    "content-type": "application/json",
                    "retry-after": "<seconds>",
                    "x-content-type-options": "nosniff",
                    "x-frame-options": "SAMEORIGIN",
                    "x-ratelimit-remaining": "109"
                },
                "json": {
                    "error": "TooManyAttempts",
                    "message": "Too many login attempts. Please wait a few minutes and try again."
                }
            }
        },
        {
            "request": {
                "method": "POST",
                "path": "/api/auth/login",
                "headers": {
                    "Accept": "*/*",
                    "Origin": "https://gallery.test",
                    "Content-Type": "application/json"
                },
                "json": {
                    "password": "contract-password"
                }
            },
            "response": {
                "status": 429,
                "headers": {
                    "access-control-allow-credentials": "true",
                    "access-control-allow-headers": "X-Requested-With, Content-Type, Accept, Origin, Authorization",
                    "access-control-allow-methods": "GET, POST, PUT, PATCH, DELETE, OPTIONS",
                    "access-control-allow-origin": "https://gallery.test",
                    "access-control-max-age": "86400",
                    "content-type": "application/json",
                    "retry-after": "<seconds>",
                    "x-content-type-options": "nosniff",
                    "x-frame-options": "SAMEORIGIN",
                    "x-ratelimit-remaining": "108"
                },
                "json": {
                    "error": "TooManyAttempts",
                    "message": "Too many login attempts. Please wait a few minutes and try again."
                }
            }
        }
    ]
}
