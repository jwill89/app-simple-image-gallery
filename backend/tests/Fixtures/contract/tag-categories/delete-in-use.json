{
    "id": "tag-categories/delete-in-use",
    "route": "DELETE /tag-categories/{category_id}",
    "about": "A category with tags: 400 CategoryInUse, with the count.",
    "steps": [
        {
            "request": {
                "method": "DELETE",
                "path": "/api/tag-categories/2",
                "headers": {
                    "Accept": "*/*",
                    "Origin": "https://gallery.test",
                    "Authorization": "Bearer <admin-token>"
                }
            },
            "response": {
                "status": 400,
                "headers": {
                    "access-control-allow-credentials": "true",
                    "access-control-allow-headers": "X-Requested-With, Content-Type, Accept, Origin, Authorization",
                    "access-control-allow-methods": "GET, POST, PUT, PATCH, DELETE, OPTIONS",
                    "access-control-allow-origin": "https://gallery.test",
                    "access-control-max-age": "86400",
                    "content-type": "application/json",
                    "x-content-type-options": "nosniff",
                    "x-frame-options": "SAMEORIGIN",
                    "x-ratelimit-remaining": "119"
                },
                "json": {
                    "error": "CategoryInUse",
                    "message": "Cannot delete \"Artist\" because 2 tag(s) belong to it. Reassign them first."
                }
            }
        }
    ]
}
