APP_NAME=Gallery
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

# The gallery's SQLite database, shared with the Slim app during the switch. Use an
# absolute path. Unset, it is database/database.sqlite. On the droplet:
# DB_DATABASE=/var/www/gallery-data/db/gallery.db
DB_CONNECTION=sqlite
# DB_DATABASE=

# Sessions and the cache stay out of the SQLite file (the plan creates no tables for
# them); the queue uses it.
SESSION_DRIVER=file
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database
CACHE_STORE=file

MAIL_MAILER=log

# ── Gallery (config/gallery.php) ─────────────────────────────────────────────
# The same variables as backend/.env.example, read the same way.

# Admin password for protected endpoints (upload, delete, duplicates, etc.).
# Login is refused entirely if this is unset (so no default can be used).
GALLERY_ADMIN_PASSWORD=

# Public base URL (used to build absolute URLs for Danbooru tag fetching / IQDB fallback).
GALLERY_URL=https://gallery.example.com

# Comma-separated list of allowed origins (backs both CORS and the CSRF origin check).
GALLERY_ALLOWED_ORIGINS=https://gallery.example.com

# Optional: Danbooru API credentials for automatic tag importing.
DANBOORU_LOGIN=
DANBOORU_API_KEY=

# Optional: FontAwesome Kit ID (just the ID, not the full URL).
FONTAWESOME_KIT_ID=

# Optional: duplicate-scan tuning (used by the Duplicates page's scan and by gallery:dupes).
# Largest Hamming distance (bits out of 64) still reported, 0-16. Default 6.
DUPLICATE_MAX_DISTANCE=
# Largest difference, 0-255, allowed in the region where a pair differs most: re-saved copies
# score low, variants with one detail changed score high. Default 36; "off" disables the check.
DUPLICATE_MAX_REGION_DIFF=

# Where media (full/, thumbs/, the ingest folder) and duplicate-scan reports live. Use
# absolute paths. Unset, they are storage/app/media and storage/app/dupes. On the droplet:
# GALLERY_MEDIA_PATH=/var/www/gallery-data/media
# GALLERY_DUPES_PATH=/var/www/gallery-data/dupes
GALLERY_MEDIA_PATH=
GALLERY_DUPES_PATH=
