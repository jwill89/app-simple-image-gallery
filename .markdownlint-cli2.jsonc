// markdownlint for the docs (`task shared:lint:md`, and CI): the shared config, which
// sets no line length. The VS Code markdownlint extension reads this file too.
{
  "config": { "extends": "shared/lint/markdown/markdownlint.jsonc" },
  "globs": ["**/*.md"],
  "ignores": [
    "**/node_modules/**",
    "**/vendor/**",
    "shared/**",
    "frontend/dist/**",
    // Playwright's notes on a failed end-to-end run.
    "frontend/test-results/**",
    "frontend/playwright-report/**",
    "backend/public/**",
    "IMPROVEMENTS.md"
  ]
}
