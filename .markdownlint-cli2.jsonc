// markdownlint for the docs (`task shared:lint:md`, and CI): the shared config from
// shared-tooling's lint/markdown, which sets no line length (decided 2026-11-05). The VS
// Code markdownlint extension reads this file too.
{
  "config": { "extends": "shared/lint/markdown/markdownlint.jsonc" },
  "globs": ["**/*.md"],
  "ignores": [
    "**/node_modules/**",
    "**/vendor/**",
    "shared/**",
    "frontend/dist/**",
    "backend/public/**",
    "IMPROVEMENTS.md"
  ]
}
