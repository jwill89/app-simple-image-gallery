{
    "id": "danbooru/tag-mapping-create-invalid",
    "route": "POST /danbooru/tag-mappings",
    "about": "An existing Danbooru tag: 400 DuplicateMapping. Missing either name: 400 InvalidInput.",
    "steps": [
        {
            "request": {
                "method": "POST",
                "path": "/api/danbooru/tag-mappings",
                "headers": {
                    "Accept": "*/*",
                    "Origin": "https://gallery.test",
                    "Authorization": "Bearer <admin-token>",
                    "Content-Type": "application/json"
                },
                "json": {
                    "danbooru_tag": "1girl",
                    "gallery_tag": "girl"
                }
            },
            "response": {
                "status": 400,
                "headers": {
                    "access-control-allow-credentials": "true",
                    "access-control-allow-headers": "X-Requested-With, Content-Type, Accept, Origin, Authorization",
                    "access-control-allow-methods": "GET, POST, PUT, PATCH, DELETE, OPTIONS",
                    "access-control-allow-origin": "https://gallery.test",
                    "access-control-max-age": "86400",
                    "content-type": "application/json",
                    "x-content-type-options": "nosniff",
                    "x-frame-options": "SAMEORIGIN",
                    "x-ratelimit-remaining": "119"
                },
                "json": {
                    "error": "DuplicateMapping",
                    "message": "A mapping for \"1girl\" already exists."
                }
            }
        },
        {
            "request": {
                "method": "POST",
                "path": "/api/danbooru/tag-mappings",
                "headers": {
                    "Accept": "*/*",
                    "Origin": "https://gallery.test",
                    "Authorization": "Bearer <admin-token>",
                    "Content-Type": "application/json"
                },
                "json": {
                    "gallery_tag": "long hair"
                }
            },
            "response": {
                "status": 400,
                "headers": {
                    "access-control-allow-credentials": "true",
                    "access-control-allow-headers": "X-Requested-With, Content-Type, Accept, Origin, Authorization",
                    "access-control-allow-methods": "GET, POST, PUT, PATCH, DELETE, OPTIONS",
                    "access-control-allow-origin": "https://gallery.test",
                    "access-control-max-age": "86400",
                    "content-type": "application/json",
                    "x-content-type-options": "nosniff",
                    "x-frame-options": "SAMEORIGIN",
                    "x-ratelimit-remaining": "118"
                },
                "json": {
                    "error": "InvalidInput",
                    "message": "Danbooru tag name is required."
                }
            }
        },
        {
            "request": {
                "method": "POST",
                "path": "/api/danbooru/tag-mappings",
                "headers": {
                    "Accept": "*/*",
                    "Origin": "https://gallery.test",
                    "Authorization": "Bearer <admin-token>",
