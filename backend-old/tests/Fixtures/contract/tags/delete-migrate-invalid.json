{
    "id": "tags/delete-migrate-invalid",
    "route": "DELETE /tags/{tag_id}/migrate-to/{target_tag_id}",
    "about": "To itself: 400 CannotMigrateToSelf. Unknown target: 404 MigrationTargetDoesNotExist. Unknown source: 404 TagDoesNotExist. Nothing is deleted.",
    "steps": [
        {
            "request": {
                "method": "DELETE",
                "path": "/api/tags/5/migrate-to/5",
                "headers": {
                    "Accept": "*/*",
                    "Origin": "https://gallery.test",
                    "Authorization": "Bearer <admin-token>"
                }
            },
            "response": {
                "status": 400,
                "headers": {
                    "access-control-allow-credentials": "true",
                    "access-control-allow-headers": "X-Requested-With, Content-Type, Accept, Origin, Authorization",
                    "access-control-allow-methods": "GET, POST, PUT, PATCH, DELETE, OPTIONS",
                    "access-control-allow-origin": "https://gallery.test",
                    "access-control-max-age": "86400",
                    "content-type": "application/json",
                    "x-content-type-options": "nosniff",
                    "x-frame-options": "SAMEORIGIN",
                    "x-ratelimit-remaining": "119"
                },
                "json": {
                    "error": "CannotMigrateToSelf",
                    "message": "A tag cannot be migrated to itself."
                }
            }
        },
        {
            "request": {
                "method": "DELETE",
                "path": "/api/tags/5/migrate-to/999",
                "headers": {
                    "Accept": "*/*",
                    "Origin": "https://gallery.test",
                    "Authorization": "Bearer <admin-token>"
                }
            },
            "response": {
                "status": 404,
                "headers": {
                    "access-control-allow-credentials": "true",
                    "access-control-allow-headers": "X-Requested-With, Content-Type, Accept, Origin, Authorization",
                    "access-control-allow-methods": "GET, POST, PUT, PATCH, DELETE, OPTIONS",
                    "access-control-allow-origin": "https://gallery.test",
                    "access-control-max-age": "86400",
                    "content-type": "application/json",
                    "x-content-type-options": "nosniff",
                    "x-frame-options": "SAMEORIGIN",
                    "x-ratelimit-remaining": "118"
                },
                "json": {
                    "error": "MigrationTargetDoesNotExist",
                    "message": "The migration target tag could not be found."
                }
            }
        },
        {
            "request": {
                "method": "DELETE",
                "path": "/api/tags/999/migrate-to/5",
                "headers": {
                    "Accept": "*/*",
                    "Origin": "https://gallery.test",
                    "Authorization": "Bearer <admin-token>"
                }
            },
            "response": {
                "status": 404,
                "headers": {
