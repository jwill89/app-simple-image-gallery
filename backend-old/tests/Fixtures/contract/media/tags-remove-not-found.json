{
    "id": "media/tags-remove-not-found",
    "route": "DELETE /media/{media_id}/tags/{tag_id}",
    "about": "An unknown tag: 404 CouldNotFindTag. An unknown item: 404 MediaDoesNotExist.",
    "steps": [
        {
            "request": {
                "method": "DELETE",
                "path": "/api/media/1/tags/999",
                "headers": {
                    "Accept": "*/*",
                    "Origin": "https://gallery.test"
                }
            },
            "response": {
                "status": 404,
                "headers": {
                    "access-control-allow-credentials": "true",
                    "access-control-allow-headers": "X-Requested-With, Content-Type, Accept, Origin, Authorization",
                    "access-control-allow-methods": "GET, POST, PUT, PATCH, DELETE, OPTIONS",
                    "access-control-allow-origin": "https://gallery.test",
                    "access-control-max-age": "86400",
                    "content-type": "application/json",
                    "x-content-type-options": "nosniff",
                    "x-frame-options": "SAMEORIGIN",
                    "x-ratelimit-remaining": "119"
                },
                "json": {
                    "error": "CouldNotFindTag",
                    "message": "The tag to remove could not be found."
                }
            }
        },
        {
            "request": {
                "method": "DELETE",
                "path": "/api/media/999/tags/3",
                "headers": {
                    "Accept": "*/*",
                    "Origin": "https://gallery.test"
                }
            },
            "response": {
                "status": 404,
                "headers": {
                    "access-control-allow-credentials": "true",
                    "access-control-allow-headers": "X-Requested-With, Content-Type, Accept, Origin, Authorization",
                    "access-control-allow-methods": "GET, POST, PUT, PATCH, DELETE, OPTIONS",
                    "access-control-allow-origin": "https://gallery.test",
                    "access-control-max-age": "86400",
                    "content-type": "application/json",
                    "x-content-type-options": "nosniff",
                    "x-frame-options": "SAMEORIGIN",
                    "x-ratelimit-remaining": "118"
                },
                "json": {
                    "error": "MediaDoesNotExist",
                    "message": "The media item could not be found."
                }
            }
        }
    ]
}
