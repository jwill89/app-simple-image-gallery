{
    "id": "media/by-ids-none-valid",
    "route": "POST /media/by-ids",
    "about": "Only zero, negative and non-numeric ids: 400 InvalidInput with a different message.",
    "steps": [
        {
            "request": {
                "method": "POST",
                "path": "/api/media/by-ids",
                "headers": {
                    "Accept": "*/*",
                    "Origin": "https://gallery.test",
                    "Content-Type": "application/json"
                },
                "json": {
                    "ids": [
                        0,
                        -1,
                        "x"
                    ]
                }
            },
            "response": {
                "status": 400,
                "headers": {
                    "access-control-allow-credentials": "true",
                    "access-control-allow-headers": "X-Requested-With, Content-Type, Accept, Origin, Authorization",
                    "access-control-allow-methods": "GET, POST, PUT, PATCH, DELETE, OPTIONS",
                    "access-control-allow-origin": "https://gallery.test",
                    "access-control-max-age": "86400",
                    "content-type": "application/json",
                    "x-content-type-options": "nosniff",
                    "x-frame-options": "SAMEORIGIN",
                    "x-ratelimit-remaining": "119"
                },
                "json": {
                    "error": "InvalidInput",
                    "message": "No valid media IDs were provided."
                }
            }
        }
    ]
}
