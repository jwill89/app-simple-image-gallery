{
  "name": "frontend",
  "private": true,
  "version": "7.0.1",
  "type": "module",
  "engines": {
    "node": ">=26"
  },
  "scripts": {
    "dev": "vite",
    "build": "vue-tsc -b && vite build",
    "preview": "vite preview",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "lint:css": "stylelint \"src/**/*.{css,vue}\"",
    "lint:css:fix": "stylelint \"src/**/*.{css,vue}\" --fix",
    "knip": "knip",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "gen:types": "npx --yes openapi-typescript@^7 ../backend/openapi.json -o src/types/api.generated.ts",
    "gen:check": "npm run gen:types && git diff --exit-code src/types/api.generated.ts",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "test:e2e": "playwright test"
  },
  "dependencies": {
    "@awesome.me/kit-4f2bd9b614": "^1.0.2",
    "@fortawesome/fontawesome-svg-core": "^7.3.1",
    "@fortawesome/vue-fontawesome": "^3.3.3",
    "@simplewebauthn/browser": "^14.0.0",
    "bulma": "^1.0.4",
    "pinia": "^4.1.0",
    "reka-ui": "^2.11.0",
    "vue": "^3.5.44",
    "vue-router": "^5.4.0"
  },
  "devDependencies": {
    "@jwill89/lint-web": "file:../shared/lint/web",
    "@jwill89/test-a11y": "file:../shared/test/a11y",
    "@playwright/test": "^1.65.0",
    "@types/node": "^26.6.6",
    "@vitejs/plugin-vue": "^6.0.10",
    "@vitest/coverage-v8": "^5.1.0",
    "@vue/test-utils": "^2.5.1",
    "@vue/tsconfig": "^0.9.1",
    "eslint": "^10.14.0",
    "jiti": "^2.7.0",
    "jsdom": "^30.1.3",
    "knip": "^6.44.1",
    "prettier": "^3.9.10",
    "stylelint": "^18.0.0",
    "typescript": "~6.0.3",
    "vite": "^8.3.5",
    "vitest": "^5.0.5",
    "vue-tsc": "3.3.13"
  }
}
