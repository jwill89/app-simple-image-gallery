{
  // The service worker (src/sw), with a worker's globals (self, clients,
  // FetchEvent) in place of the page's DOM. cache.ts and the shared constants
  // are also in tsconfig.app.json, so they type-check against both.
  "extends": "@vue/tsconfig/tsconfig.json",
  "compilerOptions": {
    "tsBuildInfoFile": "./node_modules/.tmp/tsconfig.sw.tsbuildinfo",
    "lib": ["ES2022", "WebWorker"],
    "types": [],

    /* Linting */
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "erasableSyntaxOnly": true,
    "noFallthroughCasesInSwitch": true
  },
  "include": ["src/sw/**/*.ts", "src/constants/thumbnails.ts"]
}
