# Local packages (the shared lint package, installed from a `file:` path) install as
# copies, so their own dependencies come with them; a link would leave ESLint unable to
# find its plugins.
install-links=true

# The Font Awesome kit (@awesome.me) and its core packages (@fortawesome) come from Font
# Awesome's registry. The package token lives outside the repo: in ~/.npmrc locally, and
# in the FONTAWESOME_NPM_TOKEN secret for CI and Dependabot.
@awesome.me:registry=https://npm.fontawesome.com/
@fortawesome:registry=https://npm.fontawesome.com/
