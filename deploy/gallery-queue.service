# The gallery's queue worker: ingested files, Danbooru imports and rebuilt thumbnails,
# fingerprints and metadata. Every deploy (scripts/deploy.ps1) fills in __WEB_ROOT__
# from its settings and installs the unit where it differs, and restarts the worker on
# the new code.

[Unit]
Description=Gallery queue worker
After=network.target

[Service]
# www-data owns the thumbnails and the media the worker writes, and what Apache serves.
User=www-data
Group=www-data
WorkingDirectory=__WEB_ROOT__
# --max-time ends the worker after an hour, so a slow leak can't build up. It exits
# with status 0, which only Restart=always starts again.
ExecStart=/usr/bin/php artisan queue:work --tries=3 --max-time=3600
Restart=always
RestartSec=5

[Install]
WantedBy=multi-user.target
