# ── Repo-level ────────────────────────────────────────────────────────────────
/.idea/
/.vscode/
/.claude/
/IMPROVEMENTS.md

# Deploy tooling: track the script + config template (no secrets in them); keep
# the local deploy.config.ps1 (host/user/key/app folder) out of git.
/scripts/*
!/scripts/deploy.ps1
!/scripts/HostConfig.ps1
!/scripts/deploy.config.example.ps1

# ── Backend (Laravel) ─────────────────────────────────────────────────────────
# backend/.gitignore and backend/database/.gitignore cover the app itself.
/backend/coverage/

# ── backend-old/ ──────────────────────────────────────────────────────────────
# A checkout may hold an untracked backend-old/ (its .env, a database copy,
# vendor/), which must never be committed.
/backend-old/

# ── Frontend (Vite) ───────────────────────────────────────────────────────────
# Dependencies are reinstalled via npm ci; package-lock.json IS tracked.
/frontend/node_modules/
/frontend/dist/
/frontend/coverage/
# Playwright's traces of a failed end-to-end run.
/frontend/test-results/
/frontend/playwright-report/
/frontend/.gitignore
/frontend/.vscode/
# Generated / branding assets supplied at deploy time.
/frontend/public/favicon.png
/frontend/public/icons.svg
