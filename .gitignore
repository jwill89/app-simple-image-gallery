# ── Repo-level ────────────────────────────────────────────────────────────────
/.idea/
/.vscode/
/.claude/
/IMPROVEMENTS.md

# Deploy tooling: track the script + config template (no secrets in them); keep
# the local deploy.config.ps1 (host/user/key/webroot) out of git.
/scripts/*
!/scripts/deploy.ps1
!/scripts/deploy.config.example.ps1

# ── Backend (Laravel) ─────────────────────────────────────────────────────────
# backend/.gitignore and backend/database/.gitignore cover the app itself.
/backend/coverage/

# ── Old backend (Slim, reference only until the Laravel migration is done) ────
# Dependencies are reinstalled via composer; composer.lock IS tracked (reproducible installs).
/backend-old/vendor/
# Secrets and runtime / generated data — never commit.
/backend-old/.env
/backend-old/db/gallery.db*
# Pre-migrate snapshots taken by scripts/deploy.ps1 (created on the host).
/backend-old/db/.backups/
/backend-old/cache/
/backend-old/logs/
/backend-old/dupes/
/backend-old/media/
# Test artifacts and tool caches.
/backend-old/.phpunit.cache/
/backend-old/.php-cs-fixer.cache
/backend-old/coverage/

# ── Frontend (Vite) ───────────────────────────────────────────────────────────
# Dependencies are reinstalled via npm ci; package-lock.json IS tracked.
/frontend/node_modules/
/frontend/dist/
/frontend/coverage/
/frontend/.gitignore
/frontend/.vscode/
# Generated / branding assets supplied at deploy time.
/frontend/public/favicon.png
/frontend/public/icons.svg
